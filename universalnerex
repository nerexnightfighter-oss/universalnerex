    end
    if Config.AimLockVisual then
        local sp = Camera:WorldToViewportPoint(basePos)
        if sp.Z > 0 then
            lockHighlight.Visible = true
            lockHighlight.Position = UDim2.fromOffset(sp.X, sp.Y)
        else lockHighlight.Visible = false end
    else lockHighlight.Visible = false end
end)

