loadstring([==[
-- language: Lua, file: universal_menu.lua, target: Roblox client (executor)
-- tabbed menu: main / visuals / misc. main shows "made by nerex".
-- overlay: real-time fps + ping, top-right. toggle named "ping and fps".

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui          = game:GetService("CoreGui")
local Workspace        = game:GetService("Workspace")
local Stats            = game:GetService("Stats")
local LocalPlayer      = Players.LocalPlayer

-- ==========================================================================
-- CONFIG
-- ==========================================================================
local CFG = {
    speed           = 100,
    jump            = 100,
    use_jump_height = false,
    speed_enabled   = true,
    jump_enabled    = true,
    esp_enabled     = true,
    fps_enabled     = true,
    fps_unlocked    = false,
    toggle_key      = Enum.KeyCode.RightShift,
    speed_min       = 16,
    speed_max       = 500,
    jump_min        = 50,
    jump_max        = 500,
    fps_target      = 240,
}

-- ==========================================================================
-- humanoid helpers
-- ==========================================================================
local function get_humanoid()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function apply_hacks()
    local hum = get_humanoid()
    if not hum then return end
    if CFG.speed_enabled then hum.WalkSpeed = CFG.speed end
    if CFG.jump_enabled then
        if CFG.use_jump_height then
            hum.UseJumpPower = false
            hum.JumpHeight   = CFG.jump
        else
            hum.UseJumpPower = true
            hum.JumpPower    = CFG.jump
        end
    end
end

-- ==========================================================================
-- FPS UNLOCKER
-- ==========================================================================
local function try_set_fps_cap(n)
    n = math.floor(tonumber(n) or 60)
    if n < 30 then n = 30 end
    if n > 1000 then n = 1000 end

    if type(setfpscap) == "function" then
        local ok = pcall(setfpscap, n)
        if ok then return "setfpscap" end
    end
    if type(setfflag) == "function" then
        local ok = pcall(setfflag, "DFIntTaskSchedulerTargetFps", tostring(n))
        if ok then return "setfflag" end
    end
    if type(sethiddenproperty) == "function" then
        local ok = pcall(sethiddenproperty, game, "FPS", n)
        if ok then return "sethiddenproperty" end
    end
    return nil
end

local function apply_fps_unlock(cap)
    local method = try_set_fps_cap(cap)
    if method then
        CFG.fps_unlocked = true
        CFG.fps_target   = cap
        print("[universal menu] fps unlock via " .. method .. " -> " .. cap)
        return true, method
    end
    CFG.fps_unlocked = false
    warn("[universal menu] no fps-unlock method available on this executor")
    return false, nil
end

local function restore_fps_default()
    try_set_fps_cap(60)
    CFG.fps_unlocked = false
end

-- ==========================================================================
-- PING — GetNetworkPing is the reliable source. Stats is a fallback.
-- ==========================================================================
local function get_ping()
    local ok, secs = pcall(function()
        return LocalPlayer:GetNetworkPing()
    end)
    if ok and type(secs) == "number" and secs > 0 then
        return math.floor(secs * 1000 + 0.5)
    end

    local ok2, val = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok2 and type(val) == "number" and val >= 0 then
        return math.floor(val + 0.5)
    end

    local ok3, sval = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
    end)
    if ok3 and type(sval) == "string" then
        local n = tonumber(sval:match("%d+"))
        if n then return n end
    end

    return nil
end

-- ==========================================================================
-- ESP
-- ==========================================================================
local esp_cache = {}

local function clear_esp(player)
    local data = esp_cache[player]
    if not data then return end
    if data.highlight then data.highlight:Destroy() end
    if data.billboard then data.billboard:Destroy() end
    esp_cache[player] = nil
end

local function clear_all_esp()
    for player in pairs(esp_cache) do clear_esp(player) end
    esp_cache = {}
end

local function build_esp(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    clear_esp(player)

    local hl = Instance.new("Highlight")
    hl.Name = "universal_hl"
    hl.FillColor = Color3.fromRGB(90, 150, 240)
    hl.FillTransparency = 0.6
    hl.OutlineColor = Color3.fromRGB(160, 200, 255)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = char
    hl.Parent = char

    local bill = Instance.new("BillboardGui")
    bill.Name = "universal_esp"
    bill.Size = UDim2.new(0, 140, 0, 40)
    bill.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
    bill.AlwaysOnTop = true
    bill.Adornee = hrp
    bill.Parent = char

    local name_lbl = Instance.new("TextLabel")
    name_lbl.Size = UDim2.new(1, 0, 0, 16)
    name_lbl.BackgroundTransparency = 1
    name_lbl.Text = player.Name
    name_lbl.TextColor3 = Color3.fromRGB(230, 230, 235)
    name_lbl.Font = Enum.Font.GothamBold
    name_lbl.TextSize = 12
    name_lbl.TextStrokeTransparency = 0.4
    name_lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    name_lbl.Parent = bill

    local dist_lbl = Instance.new("TextLabel")
    dist_lbl.Size = UDim2.new(1, 0, 0, 12)
    dist_lbl.Position = UDim2.new(0, 0, 0, 16)
    dist_lbl.BackgroundTransparency = 1
    dist_lbl.Text = "0m"
    dist_lbl.TextColor3 = Color3.fromRGB(160, 200, 255)
    dist_lbl.Font = Enum.Font.Gotham
    dist_lbl.TextSize = 11
    dist_lbl.TextStrokeTransparency = 0.4
    dist_lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    dist_lbl.Parent = bill

    local bar_bg = Instance.new("Frame")
    bar_bg.Size = UDim2.new(0, 60, 0, 4)
    bar_bg.Position = UDim2.new(0.5, -30, 0, 30)
    bar_bg.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
    bar_bg.BorderSizePixel = 0
    bar_bg.Parent = bill

    local bg_c = Instance.new("UICorner")
    bg_c.CornerRadius = UDim.new(1, 0)
    bg_c.Parent = bar_bg

    local bar_fill = Instance.new("Frame")
    bar_fill.Size = UDim2.new(1, 0, 1, 0)
    bar_fill.BackgroundColor3 = Color3.fromRGB(80, 220, 120)
    bar_fill.BorderSizePixel = 0
    bar_fill.Parent = bar_bg

    local bf_c = Instance.new("UICorner")
    bf_c.CornerRadius = UDim.new(1, 0)
    bf_c.Parent = bar_fill

    esp_cache[player] = {
        highlight = hl,
        billboard = bill,
        distance  = dist_lbl,
        health    = bar_fill,
        health_bg = bar_bg,
    }
end

local function tick_esp()
    if not CFG.esp_enabled then return end
    local my_char = LocalPlayer.Character
    local my_hrp  = my_char and my_char:FindFirstChild("HumanoidRootPart")
    if not my_hrp then return end

    for player, data in pairs(esp_cache) do
        local char = player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then
            if data.billboard then data.billboard.Enabled = false end
            if data.highlight then data.highlight.Enabled = false end
        else
            if data.billboard then data.billboard.Enabled = true end
            if data.highlight then data.highlight.Enabled = true end
            local dist = (hrp.Position - my_hrp.Position).Magnitude
            if data.distance then
                data.distance.Text = string.format("%dm", math.floor(dist))
            end
            if data.health and data.health_bg then
                local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                data.health.Size = UDim2.new(pct, 0, 1, 0)
                data.health.BackgroundColor3 = Color3.fromRGB(
                    math.floor(220 * (1 - pct) + 80 * pct),
                    math.floor(80 * (1 - pct) + 220 * pct),
                    120
                )
            end
        end
    end
end

local function hook_player(player)
    if player == LocalPlayer then return end
    player.CharacterAdded:Connect(function()
        task.wait(0.3)
        if CFG.esp_enabled then build_esp(player) end
    end)
    if player.Character and CFG.esp_enabled then build_esp(player) end
end

for _, p in ipairs(Players:GetPlayers()) do hook_player(p) end
Players.PlayerAdded:Connect(hook_player)
Players.PlayerRemoving:Connect(function(p) clear_esp(p) end)

-- ==========================================================================
-- OVERLAY
-- ==========================================================================
local function make_overlay()
    local old = CoreGui:FindFirstChild("universal_overlay")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "universal_overlay"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 100
    gui.Parent = CoreGui

    local lbl = Instance.new("TextLabel")
    lbl.Name = "Label"
    lbl.AnchorPoint = Vector2.new(1, 0)
    lbl.Position = UDim2.new(1, -12, 0, 12)
    lbl.Size = UDim2.new(0, 180, 0, 22)
    lbl.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    lbl.BackgroundTransparency = 0.25
    lbl.BorderSizePixel = 0
    lbl.Text = "-- fps   |   -- ms"
    lbl.TextColor3 = Color3.fromRGB(160, 200, 255)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Right
    lbl.Parent = gui

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = lbl

    local pad = Instance.new("UIPadding")
    pad.PaddingRight = UDim.new(0, 8)
    pad.PaddingLeft  = UDim.new(0, 8)
    pad.Parent = lbl

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 70)
    stroke.Thickness = 1
    stroke.Parent = lbl

    return gui, lbl
end

-- ==========================================================================
-- MENU
-- ==========================================================================
local function make_gui()
    local existing = CoreGui:FindFirstChild("universal_menu")
    if existing then existing:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "universal_menu"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.IgnoreGuiInset = true
    gui.Parent = CoreGui

    local frame = Instance.new("Frame")
    frame.Name = "Root"
    frame.Size = UDim2.new(0, 260, 0, 300)
    frame.Position = UDim2.new(0.5, -130, 0.5, -150)
    frame.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    frame.BorderSizePixel = 0
    frame.Active = false
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 70)
    stroke.Thickness = 1
    stroke.Parent = frame

    -- header
    local title_bar = Instance.new("Frame")
    title_bar.Size = UDim2.new(1, 0, 0, 44)
    title_bar.BackgroundTransparency = 1
    title_bar.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -24, 0, 18)
    title.Position = UDim2.new(0, 12, 0, 6)
    title.BackgroundTransparency = 1
    title.Text = "universal menu"
    title.TextColor3 = Color3.fromRGB(230, 230, 235)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = title_bar

    local hint = Instance.new("TextLabel")
    hint.Size = UDim2.new(1, -24, 0, 14)
    hint.Position = UDim2.new(0, 12, 0, 24)
    hint.BackgroundTransparency = 1
    hint.Text = "drag header  ·  " .. CFG.toggle_key.Name .. " to toggle"
    hint.TextColor3 = Color3.fromRGB(120, 120, 130)
    hint.Font = Enum.Font.Gotham
    hint.TextSize = 11
    hint.TextXAlignment = Enum.TextXAlignment.Left
    hint.Parent = title_bar

    local drag_btn = Instance.new("TextButton")
    drag_btn.Size = UDim2.new(1, 0, 1, 0)
    drag_btn.BackgroundTransparency = 1
    drag_btn.Text = ""
    drag_btn.AutoButtonColor = false
    drag_btn.Parent = title_bar

    local dragging, drag_start, frame_start
    drag_btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging    = true
            drag_start  = input.Position
            frame_start = frame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - drag_start
            frame.Position = UDim2.new(
                frame_start.X.Scale, frame_start.X.Offset + delta.X,
                frame_start.Y.Scale, frame_start.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- resize grip
    local function build_resize_grip()
        local GRIP = 14
        local MIN_W, MIN_H = 220, 200
        local MAX_W, MAX_H = 720, 800

        local grip = Instance.new("TextButton")
        grip.Name = "ResizeGrip"
        grip.Size = UDim2.new(0, GRIP, 0, GRIP)
        grip.Position = UDim2.new(1, -GRIP - 4, 1, -GRIP - 4)
        grip.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
        grip.BorderSizePixel = 0
        grip.Text = ""
        grip.AutoButtonColor = false
        grip.ZIndex = 10
        grip.Parent = frame

        local gc = Instance.new("UICorner")
        gc.CornerRadius = UDim.new(0, 4)
        gc.Parent = grip

        for i = 1, 3 do
            local tick = Instance.new("Frame")
            tick.Size = UDim2.new(0, 2, 0, 2 + (i - 1) * 3)
            tick.Position = UDim2.new(1, -(3 + (i - 1) * 4), 1, -(1 + (i - 1) * 4))
            tick.AnchorPoint = Vector2.new(1, 1)
            tick.BackgroundColor3 = Color3.fromRGB(140, 140, 155)
            tick.BorderSizePixel = 0
            tick.ZIndex = 11
            tick.Parent = grip
        end

        local resizing, rstart, sstart

        grip.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
                rstart   = input.Position
                sstart   = frame.AbsoluteSize
                grip.ZIndex = 20
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if not resizing then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
               or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - rstart
                local w = math.clamp(sstart.X + delta.X, MIN_W, MAX_W)
                local h = math.clamp(sstart.Y + delta.Y, MIN_H, MAX_H)
                frame.Size = UDim2.new(0, w, 0, h)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                resizing = false
                grip.ZIndex = 10
            end
        end)

        grip.MouseEnter:Connect(function()
            grip.BackgroundColor3 = Color3.fromRGB(60, 60, 72)
        end)
        grip.MouseLeave:Connect(function()
            grip.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
        end)
    end

    -- tabs
    local TAB_BAR_Y = 44
    local TAB_BAR_H = 28
    local PAGE_Y    = TAB_BAR_Y + TAB_BAR_H

    local tab_bar = Instance.new("Frame")
    tab_bar.Size = UDim2.new(1, -24, 0, TAB_BAR_H)
    tab_bar.Position = UDim2.new(0, 12, 0, TAB_BAR_Y)
    tab_bar.BackgroundColor3 = Color3.fromRGB(28, 28, 33)
    tab_bar.BorderSizePixel = 0
    tab_bar.Parent = frame

    local tbc = Instance.new("UICorner")
    tbc.CornerRadius = UDim.new(0, 6)
    tbc.Parent = tab_bar

    local tab_list = Instance.new("UIListLayout")
    tab_list.FillDirection = Enum.FillDirection.Horizontal
    tab_list.SortOrder = Enum.SortOrder.LayoutOrder
    tab_list.Padding = UDim.new(0, 2)
    tab_list.Parent = tab_bar

    local tab_pad = Instance.new("UIPadding")
    tab_pad.PaddingLeft = UDim.new(0, 2)
    tab_pad.PaddingTop = UDim.new(0, 2)
    tab_pad.PaddingBottom = UDim.new(0, 2)
    tab_pad.Parent = tab_bar

    local pages = {}
    local tab_btns = {}
    local current_tab = nil

    local ACTIVE_BG   = Color3.fromRGB(90, 150, 240)
    local ACTIVE_TEXT = Color3.fromRGB(255, 255, 255)
    local IDLE_BG     = Color3.fromRGB(28, 28, 33)
    local IDLE_TEXT   = Color3.fromRGB(150, 150, 160)

    local function select_tab(name)
        current_tab = name
        for n, pg in pairs(pages) do
            pg.Visible = (n == name)
        end
        for n, btn in pairs(tab_btns) do
            if n == name then
                btn.BackgroundColor3 = ACTIVE_BG
                btn.TextColor3 = ACTIVE_TEXT
            else
                btn.BackgroundColor3 = IDLE_BG
                btn.TextColor3 = IDLE_TEXT
            end
        end
    end

    local function add_tab(name, order)
        local btn = Instance.new("TextButton")
        btn.Name = name .. "_tab"
        btn.Size = UDim2.new(0, 72, 1, -4)
        btn.BackgroundColor3 = IDLE_BG
        btn.BorderSizePixel = 0
        btn.Text = name
        btn.TextColor3 = IDLE_TEXT
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 12
        btn.AutoButtonColor = false
        btn.LayoutOrder = order
        btn.Parent = tab_bar

        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(0, 4)
        bc.Parent = btn

        btn.MouseButton1Click:Connect(function()
            select_tab(name)
        end)

        local page = Instance.new("Frame")
        page.Name = name .. "_page"
        page.Size = UDim2.new(1, -24, 1, -(PAGE_Y + 12))
        page.Position = UDim2.new(0, 12, 0, PAGE_Y)
        page.BackgroundTransparency = 1
        page.Visible = false
        page.Parent = frame

        pages[name] = page
        tab_btns[name] = btn
        return page
    end

    -- builders
    local function build_slider(parent, y, label_text, min, max, initial, on_change)
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1, 0, 0, 48)
        holder.Position = UDim2.new(0, 0, 0, y)
        holder.BackgroundTransparency = 1
        holder.Parent = parent

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.6, 0, 0, 16)
        label.BackgroundTransparency = 1
        label.Text = label_text
        label.TextColor3 = Color3.fromRGB(210, 210, 215)
        label.Font = Enum.Font.GothamMedium
        label.TextSize = 12
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = holder

        local value_lbl = Instance.new("TextLabel")
        value_lbl.Size = UDim2.new(0.4, 0, 0, 16)
        value_lbl.Position = UDim2.new(0.6, 0, 0, 0)
        value_lbl.BackgroundTransparency = 1
        value_lbl.Text = tostring(math.floor(initial))
        value_lbl.TextColor3 = Color3.fromRGB(160, 200, 255)
        value_lbl.Font = Enum.Font.GothamBold
        value_lbl.TextSize = 12
        value_lbl.TextXAlignment = Enum.TextXAlignment.Right
        value_lbl.Parent = holder

        local hit = Instance.new("TextButton")
        hit.Size = UDim2.new(1, 0, 0, 22)
        hit.Position = UDim2.new(0, 0, 0, 22)
        hit.BackgroundTransparency = 1
        hit.Text = ""
        hit.AutoButtonColor = false
        hit.Parent = holder

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, 0, 0, 6)
        track.Position = UDim2.new(0, 0, 0, 30)
        track.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
        track.BorderSizePixel = 0
        track.ZIndex = 1
        track.Parent = holder

        local tc = Instance.new("UICorner")
        tc.CornerRadius = UDim.new(1, 0)
        tc.Parent = track

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((initial - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(90, 150, 240)
        fill.BorderSizePixel = 0
        fill.ZIndex = 2
        fill.Parent = track

        local fc = Instance.new("UICorner")
        fc.CornerRadius = UDim.new(1, 0)
        fc.Parent = fill

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 14, 0, 14)
        knob.Position = UDim2.new(fill.Size.X.Scale, -7, 0.5, -7)
        knob.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
        knob.BorderSizePixel = 0
        knob.ZIndex = 3
        knob.Parent = track

        local kc = Instance.new("UICorner")
        kc.CornerRadius = UDim.new(1, 0)
        kc.Parent = knob

        local function set_from_x(px)
            local abs_x = holder.AbsolutePosition.X
            local abs_w = holder.AbsoluteSize.X
            local rel   = math.clamp((px - abs_x) / abs_w, 0, 1)
            local v     = math.floor(min + rel * (max - min))
            fill.Size      = UDim2.new(rel, 0, 1, 0)
            knob.Position  = UDim2.new(rel, -7, 0.5, -7)
            value_lbl.Text = tostring(v)
            on_change(v)
        end

        local sliding = false

        hit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                set_from_x(input.Position.X)
            end
        end)

        local knob_hit = Instance.new("TextButton")
        knob_hit.Size = UDim2.new(0, 24, 0, 24)
        knob_hit.Position = UDim2.new(fill.Size.X.Scale, -12, 0.5, -12)
        knob_hit.BackgroundTransparency = 1
        knob_hit.Text = ""
        knob_hit.AutoButtonColor = false
        knob_hit.ZIndex = 4
        knob_hit.Parent = track

        knob_hit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
            end
        end)

        fill:GetPropertyChangedSignal("Size"):Connect(function()
            knob_hit.Position = UDim2.new(fill.Size.X.Scale, -12, 0.5, -12)
        end)

        UserInputService.InputChanged:Connect(function(input)
            if not sliding then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
               or input.UserInputType == Enum.UserInputType.Touch then
                set_from_x(input.Position.X)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end)
    end

    local function build_toggle(parent, y, label_text, state, on_change)
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1, 0, 0, 26)
