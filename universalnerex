-- fps sampling: count frames over a fixed 0.5s wall-clock window
local fps_frames  = 0
local fps_window  = 0
local fps_current = 0

-- ping sampling: poll every 0.5s
local ping_accum   = 0
local ping_current = nil

RunService.RenderStepped:Connect(function(dt)
    -- fps
    fps_frames = fps_frames + 1
    fps_window = fps_window + dt
    if fps_window >= 0.5 then
        fps_current = math.floor(fps_frames / fps_window + 0.5)
        fps_frames  = 0
        fps_window  = 0
    end

    -- ping (0.5s polling)
    ping_accum = ping_accum + dt
    if ping_accum >= 0.5 then
        local p = get_ping()
        if p then ping_current = p end
        ping_accum = 0
    end

    -- paint overlay
    if CFG.fps_enabled and overlay_lbl then
        local ftext = (fps_current > 0) and tostring(fps_current) or "--"
        local ptext = ping_current and tostring(ping_current) or "--"
        overlay_lbl.Text = ftext .. " fps   |   " .. ptext .. " ms"
    end
end)

