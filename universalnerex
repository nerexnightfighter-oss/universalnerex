    local function startSnow(card, count)
        local h = new("Frame", { Name = "Snow", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 1 }, card)
        new("UICorner", { CornerRadius = UDim.new(0, 4) }, h)
        local flakes = {}
        for i = 1, count do
            local f = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Size = UDim2.fromOffset(1.5, 1.5),
                Position = UDim2.new(math.random(), 0, -0.1, 0),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BackgroundTransparency = 0.4, BorderSizePixel = 0, ZIndex = 1,
            }, h)
            new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
            flakes[i] = { obj = f, x = math.random(), y = -0.1 - math.random(),
                sp = 0.012 + math.random() * 0.025, sw = 0.008 + math.random() * 0.02, ph = math.random() * math.pi * 2 }
        end
        task.spawn(function()
            while h.Parent do
                for _, fl in ipairs(flakes) do
                    fl.y = fl.y + fl.sp
                    fl.ph = fl.ph + 0.06
                    if fl.y > 1.1 then fl.y = -0.1 fl.x = math.random() end
                    fl.obj.Position = UDim2.new(fl.x + math.sin(fl.ph) * fl.sw, 0, fl.y, 0)
                end
                task.wait(0.03)
            end
        end)
    end

    local function startSparkles(card)
        local h = new("Frame", { Name = "Sparkles", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 1 }, card)
